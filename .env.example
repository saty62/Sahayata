# ==============================================================================
# SAHAYATA (सहायता) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to:
#   1) `backend/.env` for backend runtime
#   2) `frontend/.env.local` for Next.js frontend runtime
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
# Note: Multi-document transactions require a replica set (MongoDB Atlas or local rs0).
# If omitted or offline, Sahayata automatically boots an in-memory replica set for local evaluation.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sahayata?retryWrites=true&w=majority

# Background Queue & Redis
# BullMQ worker queue for async PDF rendering and receipt generation.
# If omitted or offline, Sahayata falls back to resilient in-process async queue.
REDIS_URL=redis://default:<password>@<redis-host>:6379

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
COOKIE_SECRET=your_cookie_encryption_secret_phrase

# AI Integration (Groq Cloud API)
# Get your API key from https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Persistent Cloud Storage (Optional for production PDFs)
# When configured, PDF receipts & 80G certificates upload to Cloudinary CDN.
# When omitted, PDFs are stored in backend/storage/pdfs/ and served locally.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Fictional Trust Statutory Credentials (for 80G Certificates & Receipts)
TRUST_NAME=सहायता चैरिटेबल ट्रस्ट (Sahayata Charitable Trust)
TRUST_PAN=AAATC1234F
TRUST_80G_NUMBER=CIT(E)/BPL/80G/2023-24/A-1089
TRUST_REGISTRATION_NUMBER=MP/BPL/TRUST/2018/00921
TRUST_ADDRESS=14, मालवीय नगर, भोपाल, मध्य प्रदेश - 462003
TRUST_HELPLINE=1800-233-4567

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
